---
/**
 * @deprecated ADR-008 Fase 0 — fora da página. Na Fase 0 as categorias são as
 * trilhas de produto do Bloco 2b (`<section id="cat-<id>">` com seu `<h2>`), não
 * chips. Mantido no repo: pode voltar como navegação do Bloco 1 na Fase 1
 * (E7). NÃO importar.
 *
 * TrilhaCategorias — E6-01 (RF-10.4). Faixa de chips, um por categoria efetiva.
 */
import type { Nicho } from '../../data/tipos';
import { resolverCategorias } from '../../lib/catalogo/resolver';

interface Props {
  nicho: Nicho;
  variante?: 'a' | 'b';
}

const { nicho, variante = 'a' } = Astro.props;
const categorias = resolverCategorias(nicho, variante);
---
<nav class="trilha" aria-label="Categorias">
  {categorias.map((cat, i) => (
    <a
      class:list={['chip', { ativo: i === 0 }]}
      href={`#cat-${cat.id}`}
      data-cat={cat.id}
      data-ir="vitrine"
      aria-current={i === 0 ? 'true' : undefined}>
      {cat.rotulo}
    </a>
  ))}
</nav>
<style>
  .trilha {
    display: flex;
    gap: var(--sp-2);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    padding-block: var(--sp-2);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-height: var(--toque-min);
    padding-inline: var(--sp-4);
    border: 1px solid var(--linha);
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: var(--fs-00);
    color: var(--texto-fraco);
  }
  .chip.ativo {
    border-color: var(--acento);
    color: var(--texto);
  }
  @media (prefers-reduced-motion: no-preference) {
    .trilha { scroll-behavior: smooth; }
  }
</style>
