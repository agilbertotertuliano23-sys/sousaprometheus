---
/**
 * MiniProduto — card de produto, skin "sufgang" (ref. sufgang.com.br,
 * `product_list`): foto 3/4 sem caixa, borda, sombra nem cantos; nome em caixa
 * alta pequena e preço logo abaixo, alinhados à esquerda. Etiqueta vira selo
 * retangular no canto da foto. No hover a 2ª foto (modelo) entra por cima e
 * sobe a faixa "Ver produto" na base da foto (o "Adicionar" da ref.). Preço em
 * --acento só quando há desconto.
 *
 * Usado por TrilhaProdutos, GradeCatalogo e DetalheProduto (relacionados). O card inteiro continua sendo UM
 * link (`<a class="mini card">`) para a tela de detalhe; por isso a "ação" é um <span> estilizado como link
 * (não pode haver <a>/<button> dentro de <a>). Atributos `data-*` preservados: o roteador de telas os usa.
 * Tokens `--ed-*` vêm de global.css (mesmo sistema dos cards da Hero e dos de vídeo).
 */
import type { Produto } from '../../data/tipos';
import { galeriaDe } from '../../lib/catalogo/resolver';
import { urlAsset } from '../../lib/catalogo/carregar';
import { formatarPreco, percentualDesconto } from '../../lib/utils';

interface Props {
  produto: Produto;
  slug: string;
  /** clipe após 1 s de hover (lib/motion/video-hover). Desligado nos relacionados do detalhe. */
  videoHover?: boolean;
}

const { produto, slug, videoHover = true } = Astro.props;
const videoSrc = videoHover && produto.video ? urlAsset(slug, produto.video) : null;
const desconto = percentualDesconto(produto.precoCentavos, produto.precoDeCentavos);
const galeria = galeriaDe(produto);
const capa = galeria[0];
const capaSrc = capa && capa.tipo === 'imagem' ? capa.src : produto.imagem;
const capaAlt = capa?.alt ?? produto.nome;

// Imagem (2) para apresentação expandida ao passar o mouse
const hoverItem = galeria.find((g, idx) => idx > 0 && g.tipo === 'imagem') ?? null;
const hoverSrc = hoverItem ? hoverItem.src : (capaSrc.includes('_1.') ? capaSrc.replace('_1.', '_2.') : null);

// Etiqueta: desconto quando houver; senão "destaque"; senão a categoria (ids como "old-money" → "OLD MONEY").
const etiqueta = desconto > 0
  ? `-${desconto}% OFF`
  : produto.destaque
    ? 'DESTAQUE'
    : (produto.categoria ?? 'NOVIDADE').replace(/[-_]/g, ' ').toUpperCase();
---
<a
  class="mini card"
  href={`#produto-${produto.sku}`}
  data-ir="detalhe"
  data-sku={produto.sku}
  data-categoria={produto.categoria ?? ''}
  data-prioridade={String(produto.prioridade ?? 50)}>
  <div class="mini-img-wrap">
    <img
      class="mini-capa image"
      src={urlAsset(slug, capaSrc)}
      alt={capaAlt}
      loading="lazy"
      decoding="async"
    />
    {hoverSrc && (
      <img
        class="mini-capa-hover image"
        src={urlAsset(slug, hoverSrc)}
        alt={`Modelo - ${capaAlt}`}
        loading="lazy"
        decoding="async"
      />
    )}
    {videoSrc && (
      <video class="mini-video" data-video-hover data-src={videoSrc} muted loop playsinline preload="none" aria-hidden="true"></video>
    )}

    <span class="mini-badge">{etiqueta}</span>
    <span class="mini-buy" aria-hidden="true">Ver produto</span>
  </div>

  <div class="mini-legenda">
    <span class="mini-nome heading">{produto.nome}</span>
    <div class:list={['mini-preco-row', { 'mini-preco-row--oferta': desconto > 0 }]}>
      {produto.precoDeCentavos && <s class="mini-preco-de">{formatarPreco(produto.precoDeCentavos)}</s>}
      <span class="mini-preco">{formatarPreco(produto.precoCentavos)}</span>
    </div>
  </div>
</a>

<style>
  .card, .mini {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
    text-align: left;
    text-decoration: none;
    color: var(--texto, #fff);
  }
  .mini:focus-visible { outline: 1px solid var(--texto, #fff); outline-offset: 4px; }

  /* foto — palco 3/4, sem cantos, fundo neutro enquanto carrega */
  .mini-img-wrap {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    margin-bottom: 6px;
    background: var(--superficie, #181818);
  }
  .mini-capa, .mini-capa-hover, .card .image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    padding: 0;
    border-radius: 0;
    transition: opacity 0.45s var(--ed-ease);
  }
  /* segunda foto (modelo) entra por cima no hover */
  .mini-capa-hover { opacity: 0; z-index: 2; pointer-events: none; }
  .mini:hover .mini-capa-hover { opacity: 1; }

  /* clipe cobre as fotos depois de 1 s de hover (classe vem do script) */
  .mini-video {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s var(--ed-ease);
  }
  .mini.video-ativo .mini-video { opacity: 1; }

  /* selo retangular no canto, como o "Sold out" da ref. */
  .mini-badge {
    position: absolute;
    z-index: 3;
    top: 8px;
    left: 8px;
    padding: 4px 7px;
    background: var(--texto, #fff);
    color: var(--c-preto, #000);
    font-family: var(--f-display);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* faixa que sobe da base da foto no hover */
  .mini-buy {
    position: absolute;
    z-index: 3;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    min-height: 40px;
    background: var(--texto, #fff);
    color: var(--c-preto, #000);
    font-family: var(--f-display);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transform: translateY(100%);
    transition: transform 0.35s var(--ed-ease);
  }
  .mini:hover .mini-buy, .mini:focus-visible .mini-buy { transform: translateY(0); }
  @media (hover: none) { .mini-buy { display: none; } }

  .mini-legenda {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mini-nome, .card .heading {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 0.74rem;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: left;
    color: inherit;
  }
  .mini-preco-row { display: flex; align-items: baseline; gap: 8px; }
  .mini-preco {
    font-family: var(--f-corpo);
    font-size: 0.78rem;
    color: inherit;
  }
  .mini-preco-de {
    font-family: var(--f-corpo);
    font-size: 0.72rem;
    color: var(--texto-fraco, #999);
    text-decoration: line-through;
  }
  .mini-preco-row--oferta .mini-preco { color: var(--acento-texto, #e06464); }

  @media (prefers-reduced-motion: reduce) {
    .mini-capa, .mini-capa-hover, .mini-buy { transition: none; }
  }
</style>

<script>
  import { ligarVideoHover } from '../../lib/motion/video-hover';
  ligarVideoHover();
</script>
