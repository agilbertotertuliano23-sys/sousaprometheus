---
/**
 * Cabecalho — barra fixa no topo, skin "sufgang" (ref. sufgang.com.br): faixa
 * preta full-bleed, marca centralizada em caixa alta com tracking largo,
 * categorias à esquerda (desktop) e atalho do catálogo à direita. Substitui o
 * NavBanner/PillNav (arquivados em components/_arquivo/).
 *
 * Vive FORA de `#app` (renderizado antes dele em SecaoUnica.astro), então
 * aparece nas 3 telas. Cada categoria abre a vitrine filtrada pelo mesmo
 * contrato de telas.ts (`data-ir="vitrine"` + `data-cat`); sem JS o `href`
 * `#cat-<id>` continua navegável por âncora.
 *
 * Menu mobile: `<details>` nativo — zero JS, abre/fecha por toque e teclado.
 */
import type { Nicho } from '../../data/tipos';
import { resolverCategorias } from '../../lib/catalogo/resolver';

interface Props {
  nicho: Nicho;
}

const { nicho } = Astro.props;
const categorias = resolverCategorias(nicho, 'a').filter((cat) => !cat.id.startsWith('_'));
---
<header class="cab" data-cab>
  <div class="cab-in">
    <details class="cab-menu">
      <summary class="cab-burger" aria-label="Abrir menu">
        <span></span><span></span>
      </summary>
      <nav class="cab-gaveta" aria-label="Categorias">
        <a class="cab-gaveta-link" href="#tela-vitrine" data-ir="vitrine">Ver tudo</a>
        {categorias.map((cat) => (
          <a class="cab-gaveta-link" href={`#cat-${cat.id}`} data-ir="vitrine" data-cat={cat.id}>{cat.rotulo}</a>
        ))}
      </nav>
    </details>

    <nav class="cab-nav" aria-label="Categorias">
      {categorias.map((cat) => (
        <a class="cab-link" href={`#cat-${cat.id}`} data-ir="vitrine" data-cat={cat.id}>{cat.rotulo}</a>
      ))}
    </nav>

    <a class="cab-marca" href="#tela-entrada" data-ir="entrada">Sousayl</a>

    <a class="cab-acao" href="#tela-vitrine" data-ir="vitrine">
      Catálogo <span class="cab-contagem">{nicho.produtos.length}</span>
    </a>
  </div>
</header>

<style>
  .cab {
    position: sticky;
    top: 0;
    z-index: 30;
    /* full-bleed: o pai (`.pagina`) é uma coluna de 480px */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-top: calc(-1 * var(--sp-6));
    background: var(--c-preto);
    color: var(--texto);
    border-bottom: 1px solid var(--linha);
  }
  .cab-in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 56px;
    padding-inline: clamp(16px, 3vw, 40px);
  }

  .cab-marca {
    grid-column: 2;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    letter-spacing: 0.32em;
    /* compensa o tracking da última letra pra centralizar de verdade */
    margin-right: -0.32em;
    text-transform: uppercase;
  }

  .cab-link,
  .cab-acao,
  .cab-gaveta-link {
    font-family: var(--f-display);
    font-size: var(--fs-00);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cab-link,
  .cab-acao {
    position: relative;
    padding-block: 6px;
  }
  /* sublinhado que cresce da esquerda — único "efeito" do header */
  .cab-link::after,
  .cab-acao::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-250) var(--ease-out);
  }
  .cab-link:hover::after,
  .cab-link:focus-visible::after,
  .cab-acao:hover::after,
  .cab-acao:focus-visible::after { transform: scaleX(1); }

  .cab-nav { display: none; }

  .cab-acao {
    grid-column: 3;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }
  .cab-contagem {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding-inline: 4px;
    background: var(--texto);
    color: var(--c-preto);
    font-size: 0.6875rem;
    letter-spacing: 0;
  }

  /* ---- mobile: hambúrguer + gaveta ---- */
  .cab-menu { grid-column: 1; grid-row: 1; justify-self: start; }
  .cab-burger {
    list-style: none;
    display: grid;
    align-content: center;
    gap: 6px;
    width: var(--toque-min);
    height: var(--toque-min);
    margin-left: -10px;
    padding-inline: 10px;
    cursor: pointer;
  }
  .cab-burger::-webkit-details-marker { display: none; }
  .cab-burger span {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--t-250) var(--ease-out);
  }
  .cab-menu[open] .cab-burger span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .cab-menu[open] .cab-burger span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  .cab-gaveta {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--sp-4) clamp(16px, 3vw, 40px) var(--sp-8);
    background: var(--c-preto);
    border-bottom: 1px solid var(--linha);
  }
  .cab-gaveta-link {
    padding-block: var(--sp-3);
    border-bottom: 1px solid var(--linha);
    font-size: var(--fs-1);
  }

  @media (min-width: 900px) {
    .cab-menu { display: none; }
    .cab-nav {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      gap: clamp(16px, 2vw, 28px);
    }
  }
</style>

<script>
  // Fecha a gaveta mobile ao escolher um destino (telas.ts troca de tela sem
  // recarregar, então o <details> ficaria aberto por cima da nova tela).
  document.querySelectorAll<HTMLDetailsElement>('.cab-menu').forEach((menu) => {
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) menu.open = false;
    });
  });
</script>
