     estado final, sem girar. */
  :global(html.js) .tt-3d.tt-girar-fim {
    transform: scale(1.12) translateX(5%);
    transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .tt-model {
