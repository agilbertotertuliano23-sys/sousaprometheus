  /* Título via ScrollFloat (React island) — escopo do Astro não alcança o
     DOM do React, por isso `:global`. `astro-island` não herda largura por
     padrão (mesmo ajuste de TresCardsInclinados.astro/CardsVidro.astro). */
  .tt-copy :global(astro-island) {
    display: block;
  }
  .tt-copy :global(.tt-copy-titulo-wrap) {
    margin: 0;
  }
  /* Escala trocada pra bater com o título grande/bold da referência Header1
     (`text-6xl md:text-9xl lg:text-10xl font-bold`) — maior que o
     `clamp(1.6rem,4vw,3rem)` padrão do ScrollFloat, que ficava pequeno
     perto do card 3D ao lado. */
  .tt-copy :global(.tt-copy-titulo) {
    font-family: 'Bigerside', sans-serif;
    color: var(--texto);
    font-weight: 400;
    font-size: clamp(2.6rem, 1.6rem + 5vw, 5.2rem);
