    color: var(--texto-fraco);
    font-size: var(--fs-0);
    line-height: var(--lh-normal);
  }

  .tt-scene {
    perspective: 1400px;
  }

  .tt-3d {
    position: relative;
    /* Revertido — pedido: "quero que o card fique do tamanho que estava,
       quero apenas ele com a animacao e dentro da sessao". Volta ao
       tamanho anterior (100% tentado antes ficou grande demais). */
    width: min(85vw, 680px);
    aspect-ratio: 1.32 / 1;
  }

  /* Giro de entrada + expansão pra um lado — pedido: "quero que ele de um
     giro, com a forca na horizontal do cartao e parand e expandindo",
     depois refinado: "quero movimentos suaves". Sob `html.js` só
     (progressive enhancement — sem JS o card fica no tamanho/posição final
     direto, sem a etapa "pequeno e centralizado"). */
  :global(html.js) .tt-3d {
    transform: scale(0.8);
    transform-style: preserve-3d;
    will-change: transform;
  }

  :global(html.js) .tt-3d.tt-girar {
    /* Duração maior + easing só de desaceleração (sem o degrau abrupto de
       antes, que pulava direto de "pequeno parado" pra "grande deslocado"
       só no fim) — o crescimento/deslocamento agora acompanha o giro
       inteiro, curva contínua. */
    /* expande/desloca junto com o giro da CÂMERA (script acima, 7 s) e, depois,
       flutua de leve — `translate` é independente do `transform` da expansão. */
    animation:
      tt-giro-expande 7s cubic-bezier(0.45, 0, 0.15, 1) forwards,
      tt-flutua-card 8s ease-in-out 7s infinite;
  }
  @keyframes tt-flutua-card {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -1.4%; }
  }

  /* rotateY gira no eixo vertical do card — a borda esquerda/direita varre
     na horizontal, "a força na horizontal do cartão". Escala e
     deslocamento crescem ao longo de TODO o giro (não só no fim), pra
     ficar suave em vez de um degrau.
     Repouso final: SEM giro residual em CSS — a inclinação de verdade
     agora vem da câmera REAL do model-viewer (`camera-orbit`, lida direto
     do ângulo salvo no Blender pelo usuário: theta 46.6°, phi 94.2°), não
     mais de um `rotateY` falso na imagem 2D renderizada (era o que causava
     a distorção/torção — um giro CSS aproxima mal um ângulo 3D real). O
     giro aqui é só o FLOURISH de entrada, sempre volta a 0 líquido
     (1080deg = 3 voltas exatas). */
  /* Giro LEVE (pedido: "giros leves, quero que ele nao gire de modo tao
     instantaneo"): antes eram 3 voltas em 2,4 s com uma curva que já largava
     em velocidade máxima (~2200°/s no começo). Agora 2 voltas em 4,8 s com
     ease-in-out suave (pico ~300°/s), uma única curva contínua — escala e
     deslocamento crescem junto, sem degrau. Termina em 0° líquido (720°). */
  @keyframes tt-giro-expande {
    /* sem `rotateY`: o giro 3D agora é da câmera do model-viewer */
    0% {
      transform: scale(0.8) translateX(0);
    }
    100% {
      transform: scale(1.12) translateX(5%);
    }
  }

