---
/**
 * SecaoUnica — E6-03. Fonte ÚNICA do markup das 3 telas (porta → catálogo →
 * detalhe). Consumida por `src/pages/index.astro` (nicho padrão) e
 * `src/pages/n/[slug].astro` (nicho da rota).
 *
 * ADR-008 Fase 0:
 *   #tela-entrada  → PortaCatalogo (proposta + organização + mosaico)
 *   #tela-vitrine  → Bloco 2a "Em alta" (se ≥ 5 produtos) + uma TrilhaProdutos
 *                    por categoria efetiva + GradeCatalogo (2c) + BlocoInformacoes
 *   #tela-detalhe  → uma <article id="produto-<sku>"> por produto (E5)
 *
 * Sem `<script>` — os scripts client são carregados por Base.astro (E6-02).
 * Sem JS: as 3 telas ficam empilhadas e navegáveis por âncora (RF-16).
 */
import type { Nicho, Produto } from '../data/tipos';
import {
  resolverCategorias,
  produtosPorCategoria,
} from '../lib/catalogo/resolver';
import PortaCatalogo from './Porta/PortaCatalogo.astro';
import TrilhaProdutos from './Vitrine/TrilhaProdutos.astro';
import GradeCatalogo from './GradeCatalogo/GradeCatalogo.astro';
import BlocoInformacoes from './Info/BlocoInformacoes.astro';
import DetalheProduto from './Detalhe/DetalheProduto.astro';

interface Props {
  nicho: Nicho;
}

const { nicho } = Astro.props;

const cats = resolverCategorias(nicho, 'a');
const porCat = produtosPorCategoria(nicho, 'a');

/**
 * Bloco 2a "Em alta" — [AUTO-DECISION] D-12. `destaque:true` primeiro, depois
 * `prioridade` desc, desempate estável; cap 6. Não renderiza se o nicho tem
 * <= 4 produtos (redundante com a grade — D-13). Cálculo INLINE (resolver.ts
 * fica intacto na Fase 0). TODO(D-12): dono pode ajustar o corte.
 */
const MAX_EM_ALTA = 6;
const MIN_NICHO_PARA_EM_ALTA = 5;
function emAlta(n: Nicho): Produto[] {
  if (n.produtos.length < MIN_NICHO_PARA_EM_ALTA) return [];
  return n.produtos
    .map((p, i) => ({ p, i }))
    .sort((a, b) => {
      const da = a.p.destaque === true ? 0 : 1;
      const db = b.p.destaque === true ? 0 : 1;
      if (da !== db) return da - db;
      const pr = (b.p.prioridade ?? 50) - (a.p.prioridade ?? 50);
      if (pr !== 0) return pr;
      return a.i - b.i;
    })
    .slice(0, MAX_EM_ALTA)
    .map((x) => x.p);
}
const destaques = emAlta(nicho);
---
<div id="app" data-tela="entrada">
  <section id="tela-entrada" class="tela">
    <PortaCatalogo nicho={nicho} />
  </section>

  <section id="tela-vitrine" class="tela">
    {destaques.length > 0 && (
      <TrilhaProdutos titulo="Em alta" produtos={destaques} slug={nicho.slug} />
    )}

    {cats.map((cat) => (
      <TrilhaProdutos
        id={`cat-${cat.id}`}
        titulo={cat.rotulo}
        kicker={cat.kicker}
        descricao={cat.descricao}
        produtos={porCat.get(cat.id) ?? []}
        slug={nicho.slug}
      />
    ))}

    <GradeCatalogo nicho={nicho} />
    <BlocoInformacoes nicho={nicho} />
  </section>

  <section id="tela-detalhe" class="tela">
    {nicho.produtos.map((p) => (
      <article id={`produto-${p.sku}`} class="detalhe-wrap" data-sku={p.sku}>
        <DetalheProduto produto={p} slug={nicho.slug} cta={nicho.cta} />
      </article>
    ))}
  </section>
</div>
<style>
  /* Nenhuma regra oculta `.tela` — isso é E6-02 (sob `html.js`). */
  .tela { margin-block: var(--sp-8); }
  .detalhe-wrap { margin-block: var(--sp-8); }
</style>
