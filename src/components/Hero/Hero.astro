---
/**
 * Hero — skin "sufgang" (ref. sufgang.com.br, seção `fade_gallery`): galeria
 * full-bleed, borda a borda, sem cantos nem moldura, que troca de cena por
 * cross-fade. Uma cena por categoria (Streetwear, Gym, Y2K, Old Money,
 * Minimal), montada com as MESMAS camadas da hero anterior
 * (src/assets/hero/cenas/<secao>/{fundo,modelo}.webp + logo.webp, o letreiro
 * recortado nas letras). Os efeitos por seção (neon/riscos, névoa/brasas,
 * estrelas, luz dourada/poeira, varredura de luz), o reflexo no logo, o
 * movimento do modelo, a entrada em cascata e a paralaxe do mouse voltaram
 * (origem: _arquivo/Hero/HeroCamadas.astro) — só sem os cards flutuantes.
 *
 * A imagem aparece INTEIRA (pedido: "permita ver a hero completa"): quadro na
 * proporção exata das cenas, sem teto de altura nem recorte, e NADA por cima
 * dela além do logo. Nome da coleção + CTA retangular branco + barras de
 * progresso ficam numa faixa preta logo abaixo da imagem. O CTA abre a vitrine filtrada pela categoria da cena
 * (`data-ir="vitrine"` + `data-cat`, contrato de telas.ts).
 *
 * Vive dentro de `#tela-entrada` (SecaoUnica). A versão anterior (painel com
 * glow + carrosséis + expositor + camadas com efeitos) está em
 * components/_arquivo/Hero/HeroPainel.astro.
 */
import type { Nicho } from '../../data/tipos';
import { resolverCategorias } from '../../lib/catalogo/resolver';

interface Props {
  nicho: Nicho;
}

const { nicho } = Astro.props;

const URLS = import.meta.glob('../../assets/hero/cenas/*/*.webp', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;
const url = (secao: string, camada: 'fundo' | 'modelo' | 'logo') =>
  URLS[`../../assets/hero/cenas/${secao}/${camada}.webp`] ?? '';

/**
 * Logo de cada cena = o letreiro original RECORTADO nas letras
 * (cenas/<secao>/logo.webp, gerado a partir de letreiro.webp). Fica numa
 * camada própria por cima do cenário/modelo. Geometria na composição
 * original (frações do quadro 2752×1536): `cx`/`cy` = centro, `w` = largura,
 * `ar` = proporção do logo (larg/alt).
 * Gym: o "GYM" vertical ficava atrás das costas do modelo (escondido) —
 * passou pra frente, à esquerda dele.
 */
interface Cena {
  id: string;
  logo: { cx: number; cy: number; w: number; ar: number };
}
const CENAS: Cena[] = [
  { id: 'streetwear', logo: { cx: 0.4988, cy: 0.5763, w: 0.9058, ar: 2.4051 } },
  { id: 'gym', logo: { cx: 0.2, cy: 0.5, w: 0.214, ar: 0.4792 } },
  { id: 'y2k', logo: { cx: 0.5033, cy: 0.5304, w: 0.9923, ar: 3.33 } },
  { id: 'old-money', logo: { cx: 0.4987, cy: 0.4946, w: 0.4312, ar: 8.1036 } },
  { id: 'minimal', logo: { cx: 0.4939, cy: 0.4971, w: 0.5423, ar: 7.4603 } },
];

const porId = new Map(resolverCategorias(nicho, 'a').map((cat) => [cat.id, cat] as const));
const cenas = CENAS.filter((c) => url(c.id, 'fundo')).map((c) => ({
  ...c,
  rotulo: porId.get(c.id)?.rotulo ?? c.id,
  temCategoria: porId.has(c.id),
}));

// ---- Efeitos por cena (voltaram da hero anterior, `_arquivo/Hero/HeroCamadas.astro`) ----
// PRNG determinístico — o HTML estático sai igual em todo build.
function prng(seed: number) {
  let s = seed >>> 0;
  return () => ((s = (Math.imul(s, 1664525) + 1013904223) >>> 0) / 4294967296);
}
const entre = (r: () => number, a: number, b: number) => +(a + r() * (b - a)).toFixed(2);

interface Particula { x: number; y: number; s: number; t: number; d: number; dx: number; alt: number }
function particulas(
  n: number,
  seed: number,
  o: { y: [number, number]; s: [number, number]; t: [number, number]; dx: [number, number]; alt: [number, number] },
): Particula[] {
  const r = prng(seed);
  return Array.from({ length: n }, () => {
    const t = entre(r, o.t[0], o.t[1]);
    return {
      x: entre(r, 2, 98),
      y: entre(r, o.y[0], o.y[1]),
      s: entre(r, o.s[0], o.s[1]),
      t,
      d: -entre(r, 0, t), // atraso negativo: já nasce "no meio do voo"
      dx: entre(r, o.dx[0], o.dx[1]),
      alt: entre(r, o.alt[0], o.alt[1]),
    };
  });
}
const estilo = (p: Particula) =>
  `--x:${p.x}%;--y:${p.y}%;--s:${p.s}px;--t:${p.t}s;--d:${p.d}s;--dx:${p.dx}px;--alt:${p.alt}px`;

const brasas = particulas(26, 11, { y: [70, 100], s: [3, 8], t: [4, 9], dx: [-60, 90], alt: [260, 560] });
const poeiraOuro = particulas(20, 23, { y: [10, 100], s: [2, 5], t: [9, 16], dx: [10, 70], alt: [40, 140] });
const poeiraMinimal = particulas(14, 37, { y: [15, 95], s: [2, 4], t: [10, 18], dx: [-30, 40], alt: [30, 110] });
const estrelas = particulas(12, 51, { y: [8, 90], s: [10, 26], t: [2.6, 5.4], dx: [0, 0], alt: [0, 0] });
const riscos = Array.from({ length: 6 }, (_, i) => {
  const r = prng(70 + i);
  return { y: entre(r, 8, 88), w: entre(r, 18, 34), t: entre(r, 1.5, 3.2), d: -entre(r, 0, 3) };
});
// reflexo varrendo as letras do logo (máscara = o próprio logo)
const BRILHO = new Set(['y2k', 'old-money']);
---
<section class="hero-sg" aria-roledescription="carrossel" aria-label={`Coleções ${nicho.nome}`} data-hero-sg>
  <div class="hero-sg-cenas">
    {cenas.map((cena, i) => {
      const ativa = i === 0;
      // só a 1ª cena baixa no load; as outras via `data-src` (script abaixo)
      const src = (camada: 'fundo' | 'modelo' | 'logo') =>
        ativa ? { src: url(cena.id, camada) } : { 'data-src': url(cena.id, camada) };
      const { cx, cy, w, ar } = cena.logo;
      return (
        <div
          class:list={['hero-sg-cena', { 'is-ativa': ativa }]}
          data-cena={cena.id}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} de ${cenas.length}: ${cena.rotulo}`}
          aria-hidden={ativa ? undefined : 'true'}
        >
          <div class="hero-sg-quadro">
            <img class="hero-sg-camada hero-sg-fundo" alt="" decoding="async" fetchpriority={ativa ? 'high' : 'auto'} {...src('fundo')} />

            {/* efeitos ATRÁS do modelo (luz/névoa) */}
            {cena.id === 'streetwear' && (<div class="fx fx--atras" aria-hidden="true"><div class="neon"></div></div>)}
            {cena.id === 'gym' && (
              <div class="fx fx--atras" aria-hidden="true"><div class="nevoa nevoa--a"></div><div class="nevoa nevoa--b"></div><div class="brasa-chao"></div></div>
            )}
            {cena.id === 'old-money' && (<div class="fx fx--atras" aria-hidden="true"><div class="luz-quente"></div></div>)}
            {cena.id === 'minimal' && (<div class="fx fx--atras" aria-hidden="true"><div class="varredura"></div></div>)}

            <div class="hero-sg-mov">
              <img class="hero-sg-camada hero-sg-modelo" alt="" decoding="async" {...src('modelo')} />
            </div>
            <div
              class:list={['hero-sg-logo', { 'hero-sg-logo--brilho': BRILHO.has(cena.id) }]}
              style={`--cx:${cx};--cy:${cy};--w:${w};--ar:${ar};--mask:url(${url(cena.id, 'logo')})`}
            >
              <img alt="" decoding="async" {...src('logo')} />
            </div>

            {/* efeitos NA FRENTE (partículas) */}
            {cena.id === 'streetwear' && (
              <div class="fx fx--frente" aria-hidden="true">
                {riscos.map((r) => (<i class="risco" style={`--y:${r.y}%;--w:${r.w}%;--t:${r.t}s;--d:${r.d}s`}></i>))}
              </div>
            )}
            {cena.id === 'gym' && (<div class="fx fx--frente" aria-hidden="true">{brasas.map((p) => (<i class="brasa" style={estilo(p)}></i>))}</div>)}
            {cena.id === 'y2k' && (<div class="fx fx--frente" aria-hidden="true">{estrelas.map((p) => (<i class="estrela" style={estilo(p)}></i>))}</div>)}
            {cena.id === 'old-money' && (
              <div class="fx fx--frente" aria-hidden="true">{poeiraOuro.map((p) => (<i class="poeira poeira--ouro" style={estilo(p)}></i>))}</div>
            )}
            {cena.id === 'minimal' && (
              <div class="fx fx--frente" aria-hidden="true">{poeiraMinimal.map((p) => (<i class="poeira poeira--claro" style={estilo(p)}></i>))}</div>
            )}
          </div>

          <div class="hero-sg-legenda">
            <div class="hero-sg-nome">
              <p class="hero-sg-kicker">{nicho.nome} · Coleção</p>
              <h2 class="hero-sg-titulo">{cena.rotulo}</h2>
            </div>
            <a
              class="hero-sg-cta"
              href={cena.temCategoria ? `#cat-${cena.id}` : '#tela-vitrine'}
              data-ir="vitrine"
              data-cat={cena.temCategoria ? cena.id : undefined}
              tabindex={ativa ? undefined : -1}
            >
              Ver coleção
            </a>
          </div>
        </div>
      );
    })}
  </div>

  {cenas.length > 1 && (
    <div class="hero-sg-barras" role="tablist" aria-label="Escolher coleção">
      {cenas.map((cena, i) => (
        <button
          class:list={['hero-sg-barra', { 'is-ativa': i === 0 }]}
          type="button"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={cena.rotulo}
          data-ir-cena={i}
        >
          <span></span>
        </button>
      ))}
    </div>
  )}
</section>

<script>
  // Cross-fade automático (6 s por cena) + barras clicáveis. Pausa com o
  // ponteiro/foco em cima, com a aba oculta e fora da tela; com movimento
  // reduzido não avança sozinho (as barras continuam funcionando).
  const raiz = document.querySelector<HTMLElement>('[data-hero-sg]');
  if (raiz) {
    const cenas = Array.from(raiz.querySelectorAll<HTMLElement>('.hero-sg-cena'));
    const barras = Array.from(raiz.querySelectorAll<HTMLButtonElement>('.hero-sg-barra'));
    const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const TEMPO = 6000;
    let atual = 0;
    let timer = 0;
    let visivel = true;
    let pausado = false;

    const carregar = (cena?: HTMLElement) => {
      cena?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        img.src = img.dataset.src ?? '';
        img.removeAttribute('data-src');
      });
    };

    // reinicia o preenchimento da barra ativa (o timer sempre recomeça do 0)
    const reiniciarBarra = () => {
      barras.forEach((b, k) => {
        const fill = b.querySelector('span');
        if (!fill) return;
        fill.style.animation = 'none';
        void fill.offsetWidth;
        fill.style.animation = k === atual ? '' : 'none';
      });
    };

    const agendar = () => {
      clearTimeout(timer);
      const parado = pausado || !visivel;
      raiz.classList.toggle('is-pausado', parado);
      if (reduzir || parado || cenas.length < 2) return;
      reiniciarBarra();
      timer = window.setTimeout(() => ir(atual + 1), TEMPO);
    };

    const ir = (i: number) => {
      atual = (i + cenas.length) % cenas.length;
      carregar(cenas[atual]);
      carregar(cenas[(atual + 1) % cenas.length]);
      cenas.forEach((c, k) => {
        const on = k === atual;
        c.classList.toggle('is-ativa', on);
        c.toggleAttribute('aria-hidden', !on);
        const cta = c.querySelector('.hero-sg-cta');
        if (on) cta?.removeAttribute('tabindex');
        else cta?.setAttribute('tabindex', '-1');
      });
      barras.forEach((b, k) => {
        b.classList.toggle('is-ativa', k === atual);
        b.setAttribute('aria-selected', String(k === atual));
      });
      reiniciarBarra();
      agendar();
    };

    const pausar = (p: boolean) => { pausado = p; agendar(); };

    barras.forEach((b) => b.addEventListener('click', () => ir(Number(b.dataset.irCena))));
    raiz.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') pausar(true); });
    raiz.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') pausar(false); });
    raiz.addEventListener('focusin', () => pausar(true));
    raiz.addEventListener('focusout', () => pausar(false));
    document.addEventListener('visibilitychange', () => pausar(document.hidden));
    new IntersectionObserver(([e]) => {
      visivel = e.isIntersecting;
      raiz.classList.toggle('is-fora', !visivel); // pausa os efeitos fora da tela
      agendar();
    }).observe(raiz);

    // Paralaxe do ponteiro (só mouse; no toque os efeitos rodam parados no lugar).
    if (!reduzir && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let alvoX = 0, alvoY = 0, x = 0, y = 0, raf = 0;
      const passo = () => {
        x += (alvoX - x) * 0.09;
        y += (alvoY - y) * 0.09;
        raiz.style.setProperty('--px', x.toFixed(3));
        raiz.style.setProperty('--py', y.toFixed(3));
        raf = Math.abs(alvoX - x) + Math.abs(alvoY - y) > 0.002 ? requestAnimationFrame(passo) : 0;
      };
      const iniciar = () => { if (!raf && visivel) raf = requestAnimationFrame(passo); };
      raiz.addEventListener('pointermove', (e) => {
        const r = raiz.getBoundingClientRect();
        alvoX = ((e.clientX - r.left) / r.width - 0.5) * 2;
        alvoY = ((e.clientY - r.top) / r.height - 0.5) * 2;
        iniciar();
      }, { passive: true });
      raiz.addEventListener('pointerleave', () => { alvoX = 0; alvoY = 0; iniciar(); }, { passive: true });
    }

    // aquece a 2ª cena quando o navegador estiver ocioso
    'requestIdleCallback' in window
      ? requestIdleCallback(() => carregar(cenas[1]))
      : setTimeout(() => carregar(cenas[1]), 1200);
    if (reduzir) raiz.classList.add('is-estatico');
    agendar();
  }
</script>

<style>
  /* A hero mostra a composição INTEIRA: o quadro tem exatamente a proporção
     das cenas (2752×1536), borda a borda, sem teto de altura nem recorte.
     A legenda (nome + CTA) e as barras ficam numa faixa preta logo abaixo,
     fora da imagem. */
  .hero-sg {
    --hero-tempo: 6s;
    --faixa: 76px;
    position: relative;
    /* full-bleed: o pai (`.pagina`) é uma coluna de 480px */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    background: var(--c-preto);
    color: #fff;
    border-bottom: 1px solid var(--linha);
  }

  /* cenas empilhadas na mesma célula do grid: a altura vem do conteúdo
     (quadro + faixa) e o cross-fade é só opacidade */
  .hero-sg-cenas { display: grid; }
  .hero-sg-cena {
    grid-area: 1 / 1;
    position: relative;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.2s var(--ease-in-out-soft), visibility 0s linear 1.2s;
  }
  .hero-sg-cena.is-ativa {
    opacity: 1;
    visibility: visible;
    transition: opacity 1.2s var(--ease-in-out-soft), visibility 0s;
  }

  .hero-sg-quadro {
    position: relative;
    aspect-ratio: 2752 / 1536;
    overflow: hidden;
    container-type: inline-size;
  }
  .hero-sg-camada {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }

  /* Logo na posição da composição original (frações do quadro). `cqw` =
     largura do quadro; a altura do quadro é cqw × 1536/2752. */
  .hero-sg-logo {
    --Ph: calc(100cqw * 1536 / 2752);
    --W: min(var(--w) * 100cqw, var(--Ph) * 0.96 * var(--ar));
    --Hl: calc(var(--W) / var(--ar));
    position: absolute;
    z-index: 2;
    width: var(--W);
    height: var(--Hl);
    left: clamp(0px, var(--cx) * 100cqw - var(--W) / 2, 100cqw - var(--W));
    top: clamp(0px, var(--cy) * var(--Ph) - var(--Hl) / 2, var(--Ph) - var(--Hl));
    pointer-events: none;
    user-select: none;
    /* paralaxe (mouse) — `translate` é independente de `transform` */
    translate: calc(var(--px) * -15px) calc(var(--py) * -9px);
  }
  .hero-sg-logo img { display: block; width: 100%; height: 100%; object-fit: contain; user-select: none; }

  /* ===== Efeitos (voltaram da hero anterior — HeroCamadas) ===== */
  .hero-sg { --px: 0; --py: 0; }

  /* paralaxe: quem está mais perto move mais */
  .hero-sg-fundo { translate: calc(var(--px) * -9px) calc(var(--py) * -6px); }
  .hero-sg-mov {
    position: absolute;
    inset: 0;
    translate: calc(var(--px) * -24px) calc(var(--py) * -13px);
    transform-origin: 50% 100%;
    animation: hero-flutuar 6s ease-in-out infinite;
  }
  .hero-sg-cena[data-cena='streetwear'] .hero-sg-mov { animation-name: hero-queda; animation-duration: 5.2s; transform-origin: 50% 50%; }
  .hero-sg-cena[data-cena='gym'] .hero-sg-mov { animation-name: hero-respirar; animation-duration: 4.4s; }
  .hero-sg-cena[data-cena='y2k'] .hero-sg-mov { animation-name: hero-balanco; animation-duration: 5.6s; }
  @keyframes hero-flutuar { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(0, -5px, 0); } }
  @keyframes hero-queda { 0%, 100% { transform: translate3d(0, 0, 0) rotate(0); } 50% { transform: translate3d(6px, -12px, 0) rotate(0.6deg); } }
  @keyframes hero-respirar { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.008); } }
  @keyframes hero-balanco { 0%, 100% { transform: translate3d(0, 0, 0) rotate(0); } 50% { transform: translate3d(-4px, -4px, 0) rotate(-0.25deg); } }

  /* pausa o que não está à vista: cenas inativas e a hero fora da tela */
  .hero-sg-cena:not(.is-ativa) * { animation-play-state: paused !important; }
  .hero-sg.is-fora * { animation-play-state: paused !important; }

  /* respiro do cenário (ken-burns) + entrada em cascata ao trocar de cena:
     fundo → logo → modelo. Cenário ampliado 3% no estado final: dá margem
     pra paralaxe não abrir borda. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-sg-fundo {
      transform: scale(1.08);
      transform-origin: 50% 100%;
      transition: transform 7s linear;
    }
    .hero-sg-cena.is-ativa .hero-sg-fundo { transform: scale(1.03); }

    .hero-sg-modelo { opacity: 0; transform: translate3d(0, 34px, 0) scale(0.98); transform-origin: 50% 100%; }
    .hero-sg-cena.is-ativa .hero-sg-modelo {
      opacity: 1;
      transform: none;
      transition: opacity 0.8s 0.28s ease, transform 1.1s 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .hero-sg-logo img { opacity: 0; filter: blur(14px); transform: scale(1.06); }
    .hero-sg-cena.is-ativa .hero-sg-logo img {
      opacity: 1;
      filter: blur(0);
      transform: none;
      transition: opacity 0.8s 0.12s ease, filter 0.9s 0.12s ease, transform 1.1s 0.12s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }

  /* reflexo varrendo as letras (Y2K cromado / Old Money dourado): a máscara é o
     próprio logo, então o brilho só aparece sobre as letras. */
  .hero-sg-logo--brilho::after {
    content: '';
    position: absolute;
    inset: 0;
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    background: linear-gradient(105deg, transparent 38%, rgba(255, 255, 255, 0.95) 50%, transparent 62%) 130% 0 / 260% 100% no-repeat;
    mix-blend-mode: overlay;
    animation: hero-reflexo 5.5s 1.2s ease-in-out infinite;
  }
  .hero-sg-cena[data-cena='old-money'] .hero-sg-logo--brilho::after {
    background-image: linear-gradient(105deg, transparent 38%, rgba(255, 224, 160, 0.95) 50%, transparent 62%);
    animation-duration: 7s;
  }
  @keyframes hero-reflexo { 0% { background-position: 130% 0; } 45%, 100% { background-position: -30% 0; } }

  /* ---- camadas de efeito por cena ---- */
  .fx { position: absolute; inset: 0; pointer-events: none; }
  .fx--atras { z-index: 0; }
  .fx--frente { z-index: 5; }

  /* Streetwear — neon verde pulsando sob a figura + riscos de velocidade */
  .neon {
    position: absolute; inset: 0;
    background: radial-gradient(52% 38% at 50% 94%, rgba(60, 255, 150, 0.32), transparent 72%),
                radial-gradient(30% 24% at 72% 70%, rgba(80, 200, 255, 0.16), transparent 70%);
    mix-blend-mode: screen;
    animation: hero-pulso 3.4s ease-in-out infinite;
  }
  @keyframes hero-pulso { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
  .risco {
    position: absolute; left: 0; top: var(--y); width: var(--w); height: 2px;
    background: linear-gradient(90deg, transparent, rgba(190, 230, 255, 0.7), transparent);
    transform: translate3d(-110%, 0, 0) rotate(-16deg);
    opacity: 0;
    animation: hero-correr var(--t) var(--d) linear infinite;
  }
  @keyframes hero-correr {
    0% { transform: translate3d(-110%, 0, 0) rotate(-16deg); opacity: 0; }
    12% { opacity: 0.75; }
    100% { transform: translate3d(420%, 0, 0) rotate(-16deg); opacity: 0; }
  }

  /* Gym — névoa à deriva + brasas subindo + brilho quente no chão */
