---
/**
 * SecaoContato — 3ª seção depois da Hero (referência HAUS Studio): painel de
 * imagem em largura total (aqui só o <Slot>, sem imagem), textos pequenos nos
 * cantos, CTA no centro e uma palavra gigante cortada na borda de baixo.
 * Wireframe: `### SECAO 3` em design-systems/hero-poster-haus/wireframe.txt.
 *
 * O link é o mesmo da faixa "Divulgação" que foi pro arquivo
 * (components/_arquivo/FlowingMenu/FlowingMenuDivulgacao.astro).
 */
import Slot from './Slot.astro';

const whatsapp =
  'https://wa.me/?text=' +
  encodeURIComponent('Olá! Vim pelo site e gostaria de saber mais sobre divulgação.');
---
<section class="hx-contato" aria-labelledby="hx-contato-titulo">
  <div class="hx-painel">
    <Slot nome="contato-fundo" rotulo="Componente · imagem / fundo em largura total" cheio />

    <div class="hx-conteudo">
      <p class="hx-mono hx-esq">
        Para agendar uma conversa e conhecer os canais de divulgação, fale com a gente.
      </p>
      <a class="hx-cta" href={whatsapp} target="_blank" rel="noopener noreferrer">[ Falar no WhatsApp ]</a>
      <p class="hx-mono hx-dir">
        Divulgação, parcerias e a sua marca aqui: entre em contato e a gente responde.
      </p>
    </div>

    <h2 class="hx-gigante" id="hx-contato-titulo">CONTATO</h2>
  </div>
</section>

<style>
  .hx-contato {
    --pad: clamp(10px, 3vw, 32px);
    --hx-papel: #f2f2ef;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding: var(--pad);
    background: #000;
    color: var(--hx-papel);
  }

  .hx-painel {
    position: relative;
    overflow: hidden;
    min-height: clamp(380px, 52vw, 740px);
    background: #0d0d0e;
    border-radius: var(--raio-sm);
  }

  .hx-conteudo {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    justify-items: start;
    padding: clamp(18px, 2.6vw, 40px);
  }

  .hx-mono {
    margin: 0;
    max-width: 34ch;
    font-family: var(--ed-rotulo-fonte);
    font-size: clamp(0.66rem, 0.6rem + 0.25vw, 0.8rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.3;
  }

  .hx-cta {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 6px 4px;
    font-family: var(--ed-rotulo-fonte);
    font-size: clamp(0.76rem, 0.7rem + 0.3vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color 0.18s ease, letter-spacing 0.18s ease;
  }
  .hx-cta:hover, .hx-cta:focus-visible { border-bottom-color: currentColor; letter-spacing: 0.1em; }
  .hx-cta:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  /* palavra gigante cortada na borda de baixo (o painel tem overflow hidden) */
  .hx-gigante {
    position: absolute;
    left: 2%;
    bottom: -0.17em;
    z-index: 1;
    margin: 0;
    font-family: 'Anton', 'Bebas Neue', Impact, sans-serif;
    font-weight: 400;
    font-size: clamp(110px, 25.5vw, 430px);
    line-height: 0.8;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: var(--hx-papel);
    pointer-events: none;
    user-select: none;
  }

  @media (min-width: 900px) {
    .hx-conteudo {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: start;
      padding-top: clamp(28px, 4vw, 64px);
    }
    .hx-cta { justify-self: center; align-self: start; }
    .hx-dir { justify-self: end; text-align: right; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hx-cta { transition: none; }
  }
</style>
