---
/**
 * HeroCamadas — a Hero em CAMADAS (cenário / letreiro / modelo) em vez do
 * banner pronto. Vive dentro de `<header class="hero">` (ver Hero.astro), atrás
 * de tudo (z-index 0): PixelFundoHero (1), `.hero-in` (2) e os cards (4)
 * continuam por cima.
 *
 * As imagens vêm de src/assets/hero/cenas/<secao>/{fundo,modelo,letreiro}.webp
 * (gerado por scripts/montar-cenas-hero.mjs — as camadas entram COMO VIERAM,
 * sem recomposição). Modelo e letreiro (quando em quadro cheio) usam o mesmo
 * enquadramento do banner antigo: `object-fit: cover` + `right bottom`.
 * Os letreiros recortados (Old Money / Minimal) são posicionados por CSS
 * (`--l-x/--l-y/--l-w`, centro + largura em % da Hero).
 *
 * Troca de seção: escuta o `hero:secao` que o card central já dispara
 * (detail.categoriaId) — nada mudou no driver. Só a cena da 1ª seção vem
 * carregada; as outras usam `data-src` e são buscadas quando a vizinha fica
 * ativa (ou ao ativar).
 *
 * Efeitos: paralaxe (mouse + scroll), entrada em cascata por camada, e um
 * efeito próprio por seção (CSS puro: transform/opacity). Respeita
 * `prefers-reduced-motion` e pausa tudo quando a Hero sai da tela.
 *
 * Restaurada ao estado ANTERIOR ao pôster (pedido: "retire todas as figuras e
 * deixe o efeito que estava nas imagens, com a hero antes de tudo"). O desenho
 * do pôster (HeroPoster.astro) está em components/_arquivo/Hero/.
 */
const URLS = import.meta.glob('../../../assets/hero/cenas/*/*.webp', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;
const url = (secao: string, camada: 'fundo' | 'modelo' | 'letreiro') =>
  URLS[`../../../assets/hero/cenas/${secao}/${camada}.webp`] ?? '';

// PRNG determinístico — o HTML estático sai igual em todo build.
function prng(seed: number) {
  let s = seed >>> 0;
  return () => ((s = (Math.imul(s, 1664525) + 1013904223) >>> 0) / 4294967296);
}
const entre = (r: () => number, a: number, b: number) => +(a + r() * (b - a)).toFixed(2);

interface Particula { x: number; y: number; s: number; t: number; d: number; dx: number; alt: number }
function particulas(n: number, seed: number, o: { x?: [number, number]; y: [number, number]; s: [number, number]; t: [number, number]; dx: [number, number]; alt: [number, number] }): Particula[] {
  const r = prng(seed);
  return Array.from({ length: n }, () => {
    const t = entre(r, o.t[0], o.t[1]);
    return {
      x: entre(r, o.x?.[0] ?? 2, o.x?.[1] ?? 98),
      y: entre(r, o.y[0], o.y[1]),
      s: entre(r, o.s[0], o.s[1]),
      t,
      d: -entre(r, 0, t), // atraso negativo: já nasce "no meio do voo"
      dx: entre(r, o.dx[0], o.dx[1]),
      alt: entre(r, o.alt[0], o.alt[1]),
    };
  });
}
const estilo = (p: Particula) => `--x:${p.x}%;--y:${p.y}%;--s:${p.s}px;--t:${p.t}s;--d:${p.d}s;--dx:${p.dx}px;--alt:${p.alt}px`;

const brasas = particulas(26, 11, { y: [70, 100], s: [3, 8], t: [4, 9], dx: [-60, 90], alt: [260, 560] });
const poeiraOuro = particulas(20, 23, { y: [10, 100], s: [2, 5], t: [9, 16], dx: [10, 70], alt: [40, 140] });
const poeiraMinimal = particulas(14, 37, { y: [15, 95], s: [2, 4], t: [10, 18], dx: [-30, 40], alt: [30, 110] });
const estrelas = particulas(12, 51, { y: [8, 90], s: [10, 26], t: [2.6, 5.4], dx: [0, 0], alt: [0, 0] });
const riscos = Array.from({ length: 6 }, (_, i) => {
  const r = prng(70 + i);
  return { y: entre(r, 8, 88), w: entre(r, 18, 34), t: entre(r, 1.5, 3.2), d: -entre(r, 0, 3) };
});

/**
 * Uma cena por seção. `letreiro`: 'atras' = entre o cenário e o modelo (o
 * modelo cobre parte das letras); 'frente' = por cima do modelo.
 * `recorte`: letreiro não vem em quadro cheio → posição (centro/largura) em %.
 */
interface Cena {
  id: string;
  letreiro: 'atras' | 'frente';
  recorte?: { x: number; y: number; w: number };
  brilho?: boolean; // reflexo varrendo as letras (máscara = próprio letreiro)
}
const CENAS: Cena[] = [
  { id: 'streetwear', letreiro: 'frente' },
  { id: 'gym', letreiro: 'atras' },
  { id: 'y2k', letreiro: 'frente', brilho: true },
  { id: 'old-money', letreiro: 'frente', recorte: { x: 50, y: 49, w: 46 }, brilho: true },
  { id: 'minimal', letreiro: 'frente', recorte: { x: 49.5, y: 49, w: 66 } },
];
const ATIVA = 'streetwear';
---
<div class="hero-cenas" aria-hidden="true">
  {CENAS.map((cena) => {
    const ativa = cena.id === ATIVA;
    const src = (camada: 'fundo' | 'modelo' | 'letreiro') => (ativa ? { src: url(cena.id, camada) } : { 'data-src': url(cena.id, camada) });
    const letreiro = (
      <div
        class:list={['camada', 'camada--letreiro', { 'camada--recorte': !!cena.recorte, 'camada--brilho': !!cena.brilho }]}
        style={`--mask:url(${url(cena.id, 'letreiro')})${cena.recorte ? `;--l-x:${cena.recorte.x}%;--l-y:${cena.recorte.y}%;--l-w:${cena.recorte.w}%` : ''}`}
      >
        <div class="mov"><img alt="" decoding="async" loading="eager" {...src('letreiro')} /></div>
      </div>
    );
    return (
      <div class:list={['cena', `cena--${cena.id}`, { 'is-ativa': ativa }]} data-secao={cena.id}>
        <div class="camada camada--fundo">
          <div class="mov"><img alt="" decoding="async" loading="eager" fetchpriority={ativa ? 'high' : 'auto'} {...src('fundo')} /></div>
        </div>

        {/* efeitos ATRÁS (luz/névoa) */}
        {cena.id === 'streetwear' && (<div class="fx fx--atras"><div class="neon"></div></div>)}
        {cena.id === 'gym' && (<div class="fx fx--atras"><div class="nevoa nevoa--a"></div><div class="nevoa nevoa--b"></div><div class="brasa-chao"></div></div>)}
        {cena.id === 'old-money' && (<div class="fx fx--atras"><div class="luz-quente"></div></div>)}
        {cena.id === 'minimal' && (<div class="fx fx--atras"><div class="varredura"></div></div>)}

        {cena.letreiro === 'atras' && letreiro}

        <div class="camada camada--modelo">
          <div class="mov"><img alt="" decoding="async" loading="eager" {...src('modelo')} /></div>
        </div>

        {cena.letreiro === 'frente' && letreiro}

        {/* efeitos NA FRENTE (partículas) */}
        {cena.id === 'streetwear' && (
          <div class="fx fx--frente">{riscos.map((r) => (<i class="risco" style={`--y:${r.y}%;--w:${r.w}%;--t:${r.t}s;--d:${r.d}s`}></i>))}</div>
        )}
        {cena.id === 'gym' && (<div class="fx fx--frente">{brasas.map((p) => (<i class="brasa" style={estilo(p)}></i>))}</div>)}
        {cena.id === 'y2k' && (<div class="fx fx--frente">{estrelas.map((p) => (<i class="estrela" style={estilo(p)}></i>))}</div>)}
        {cena.id === 'old-money' && (<div class="fx fx--frente">{poeiraOuro.map((p) => (<i class="poeira poeira--ouro" style={estilo(p)}></i>))}</div>)}
        {cena.id === 'minimal' && (<div class="fx fx--frente">{poeiraMinimal.map((p) => (<i class="poeira poeira--claro" style={estilo(p)}></i>))}</div>)}
      </div>
    );
  })}
</div>

<style>
  /* Faixa de leitura leve à esquerda (onde cai o texto) — no lugar do scrim
     que ficava no background do `.hero`. */
  .hero-cenas {
    --px: 0; --py: 0; --sy: 0;
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
    contain: paint;
    background: #0b0c0e;
  }
  .hero-cenas::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 9;
    background: linear-gradient(100deg, rgba(20, 18, 14, 0.22) 0%, rgba(20, 18, 14, 0.05) 42%, transparent 62%);
  }

  .cena {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.7s ease, visibility 0s linear 0.7s;
  }
  .cena.is-ativa {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.7s ease, visibility 0s;
  }
  .cena:not(.is-ativa) * { animation-play-state: paused !important; }
  .hero-cenas.is-fora * { animation-play-state: paused !important; }

  /* ---- camadas: `.camada` = paralaxe (mouse + scroll) · `.mov` = movimento
     idle (flutuar) · `img` = entrada. Três níveis pra transform não brigar. */
  .camada {
    --dx: 0; --dy: 0; --dsy: 0;
    position: absolute;
    inset: 0;
    will-change: transform;
    transform: translate3d(
      calc(var(--px) * var(--dx) * 1px),
      calc(var(--py) * var(--dy) * 1px + var(--sy) * var(--dsy) * 1px),
      0
    );
  }
  .mov { position: absolute; inset: 0; }
  .camada img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
    user-select: none;
  }
  /* profundidade: quem está mais perto move mais; no scroll o fundo "desce" mais */
  .camada--fundo { --dx: -9; --dy: -6; --dsy: 26; }
  .camada--letreiro { --dx: -15; --dy: -9; --dsy: 14; }
  .camada--modelo { --dx: -24; --dy: -13; --dsy: 4; }

  /* Fundo: ampliado 5% ancorado embaixo (o "chão" não sai do lugar) — dá
     margem pro paralaxe não abrir borda; respira em ken-burns lento. */
  .camada--fundo .mov { transform-origin: 50% 100%; animation: kenburns 24s ease-in-out infinite alternate; }
  .camada--fundo img { transform: scale(1.14); transform-origin: 50% 100%; }
  .is-ativa .camada--fundo img { transform: scale(1.05); transition: transform 1.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes kenburns { from { transform: scale(1); } to { transform: scale(1.045); } }

  /* Entrada em cascata: fundo → letreiro → modelo */
  .camada--modelo img { opacity: 0; transform: translate3d(0, 34px, 0) scale(0.98); transform-origin: 50% 100%; }
  .is-ativa .camada--modelo img {
    opacity: 1; transform: none;
    transition: opacity 0.8s 0.28s ease, transform 1.1s 0.28s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .camada--letreiro img { opacity: 0; filter: blur(14px); transform: scale(1.06); }
  .is-ativa .camada--letreiro img {
    opacity: 1; filter: blur(0); transform: none;
    transition: opacity 0.8s 0.12s ease, filter 0.9s 0.12s ease, transform 1.1s 0.12s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Old Money: o título "se escreve" da esquerda pra direita */
  .cena--old-money .camada--letreiro img { filter: none; transform: none; clip-path: inset(0 100% 0 0); opacity: 1; }
  .cena--old-money.is-ativa .camada--letreiro img { clip-path: inset(0 0 0 0); transition: clip-path 1.5s 0.2s cubic-bezier(0.6, 0, 0.2, 1); }

  /* Letreiro recortado (Old Money / Minimal): caixa própria, centro + largura em % */
  .camada--recorte {
    inset: auto;
    left: var(--l-x);
    top: var(--l-y);
    width: var(--l-w);
    aspect-ratio: 2170 / 725;
    translate: -50% -50%;
  }
  .camada--recorte img { object-fit: fill; }

  /* Reflexo varrendo as letras (Y2K cromado / Old Money dourado): a máscara é o
     próprio letreiro, então o brilho só aparece sobre as letras. */
  .camada--brilho .mov::after {
    content: '';
    position: absolute;
    inset: 0;
    -webkit-mask-image: var(--mask);
    mask-image: var(--mask);
    -webkit-mask-size: cover;
    mask-size: cover;
    -webkit-mask-position: right bottom;
    mask-position: right bottom;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    background: linear-gradient(105deg, transparent 38%, rgba(255, 255, 255, 0.95) 50%, transparent 62%) 130% 0 / 260% 100% no-repeat;
    mix-blend-mode: overlay;
    animation: reflexo 5.5s 1.2s ease-in-out infinite;
  }
  .cena--old-money .camada--brilho .mov::after {
    -webkit-mask-size: 100% 100%; mask-size: 100% 100%; -webkit-mask-position: center; mask-position: center;
    background-image: linear-gradient(105deg, transparent 38%, rgba(255, 224, 160, 0.95) 50%, transparent 62%);
    animation-duration: 7s;
  }
  @keyframes reflexo { 0% { background-position: 130% 0; } 45%, 100% { background-position: -30% 0; } }

  /* ---- movimento idle do modelo, por seção */
  .camada--modelo .mov { transform-origin: 50% 100%; animation: flutuar 6s ease-in-out infinite; }
  .cena--streetwear .camada--modelo .mov { animation: queda 5.2s ease-in-out infinite; transform-origin: 50% 50%; }
  .cena--gym .camada--modelo .mov { animation: respirar 4.4s ease-in-out infinite; }
  .cena--y2k .camada--modelo .mov { animation: balanco 5.6s ease-in-out infinite; }
  @keyframes flutuar { 0%, 100% { transform: translate3d(0, 0, 0); } 50% { transform: translate3d(0, -5px, 0); } }
  @keyframes queda { 0%, 100% { transform: translate3d(0, 0, 0) rotate(0); } 50% { transform: translate3d(6px, -12px, 0) rotate(0.6deg); } }
  @keyframes respirar { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.008); } }
  @keyframes balanco { 0%, 100% { transform: translate3d(0, 0, 0) rotate(0); } 50% { transform: translate3d(-4px, -4px, 0) rotate(-0.25deg); } }

  /* ---- camadas de efeito */
  .fx { position: absolute; inset: 0; pointer-events: none; }
  .fx--atras { z-index: 0; }
  .fx--frente { z-index: 5; }

  /* Streetwear — neon verde pulsando sob a figura + riscos de velocidade */
  .neon {
    position: absolute; inset: 0;
    background: radial-gradient(52% 38% at 50% 94%, rgba(60, 255, 150, 0.32), transparent 72%),
                radial-gradient(30% 24% at 72% 70%, rgba(80, 200, 255, 0.16), transparent 70%);
    mix-blend-mode: screen;
    animation: pulso 3.4s ease-in-out infinite;
  }
  @keyframes pulso { 0%, 100% { opacity: 0.55; } 50% { opacity: 1; } }
  .risco {
    position: absolute; left: 0; top: var(--y); width: var(--w); height: 2px;
    background: linear-gradient(90deg, transparent, rgba(190, 230, 255, 0.7), transparent);
    transform: translate3d(-110%, 0, 0) rotate(-16deg);
    opacity: 0;
    animation: correr var(--t) var(--d) linear infinite;
  }
  @keyframes correr {
    0% { transform: translate3d(-110%, 0, 0) rotate(-16deg); opacity: 0; }
    12% { opacity: 0.75; }
    100% { transform: translate3d(420%, 0, 0) rotate(-16deg); opacity: 0; }
  }

  /* Gym — névoa à deriva + brasas subindo + brilho quente no chão */
  .nevoa { position: absolute; inset: -10% -20%; mix-blend-mode: screen; opacity: 0.38; }
  .nevoa--a { background: radial-gradient(45% 35% at 30% 60%, rgba(190, 200, 215, 0.55), transparent 70%); animation: deriva 22s ease-in-out infinite alternate; }
  .nevoa--b { background: radial-gradient(40% 30% at 70% 45%, rgba(160, 170, 190, 0.5), transparent 70%); animation: deriva 30s ease-in-out infinite alternate-reverse; }
  @keyframes deriva { from { transform: translate3d(-6%, 0, 0); } to { transform: translate3d(6%, -2%, 0); } }
  .brasa-chao {
    position: absolute; inset: 0;
    background: radial-gradient(48% 22% at 50% 100%, rgba(255, 110, 30, 0.34), transparent 72%);
    mix-blend-mode: screen;
    animation: pulso 2.8s ease-in-out infinite;
  }
  .brasa {
    position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle, #ffe2a0 0, #ff9a3a 45%, rgba(255, 90, 20, 0) 72%);
    box-shadow: 0 0 8px 2px rgba(255, 120, 40, 0.55);
    opacity: 0;
    animation: brasa var(--t) var(--d) linear infinite;
  }
  @keyframes brasa {
    0% { transform: translate3d(0, 0, 0) scale(0.7); opacity: 0; }
    12% { opacity: 1; }
    100% { transform: translate3d(var(--dx), calc(var(--alt) * -1), 0) scale(0.15); opacity: 0; }
  }

  /* Y2K — estrelinhas de 4 pontas piscando */
  .estrela {
    position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s);
    background: #fff;
    clip-path: polygon(50% 0, 62% 38%, 100% 50%, 62% 62%, 50% 100%, 38% 62%, 0 50%, 38% 38%);
    transform: scale(0);
    opacity: 0;
    animation: brilho var(--t) var(--d) ease-in-out infinite;
  }
  @keyframes brilho {
    0%, 100% { transform: scale(0) rotate(0); opacity: 0; }
    45%, 55% { transform: scale(1) rotate(45deg); opacity: 1; }
  }

  /* Old Money — luz dourada de fim de tarde respirando + poeira de ouro */
  .luz-quente {
    position: absolute; inset: 0;
    background: radial-gradient(70% 60% at 86% 8%, rgba(255, 196, 110, 0.4), transparent 62%);
    mix-blend-mode: screen;
    animation: pulso 7s ease-in-out infinite;
  }
  /* Minimal — faixa de luz cruzando devagar */
  .varredura {
    position: absolute; top: -10%; bottom: -10%; left: 0; width: 55%;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 246, 228, 0.3) 50%, transparent 70%);
    mix-blend-mode: screen;
    transform: translate3d(-90%, 0, 0);
    animation: cruzar 11s ease-in-out infinite;
  }
  @keyframes cruzar { 0% { transform: translate3d(-90%, 0, 0); } 60%, 100% { transform: translate3d(200%, 0, 0); } }

  .poeira {
    position: absolute; left: var(--x); top: var(--y); width: var(--s); height: var(--s);
    border-radius: 50%;
    opacity: 0;
    animation: poeira var(--t) var(--d) ease-in-out infinite;
  }
  .poeira--ouro { background: radial-gradient(circle, #ffe7b0, rgba(255, 190, 90, 0) 70%); box-shadow: 0 0 6px 1px rgba(255, 200, 110, 0.5); }
  .poeira--claro { background: radial-gradient(circle, #fff, rgba(255, 255, 255, 0) 70%); box-shadow: 0 0 5px 1px rgba(255, 255, 255, 0.45); }
  @keyframes poeira {
    0% { transform: translate3d(0, 0, 0); opacity: 0; }
    30% { opacity: 0.9; }
    70% { opacity: 0.7; }
    100% { transform: translate3d(var(--dx), calc(var(--alt) * -1), 0); opacity: 0; }
  }

  /* Mobile: menos partículas, sem paralaxe de ponteiro (o JS nem liga) */
  @media (max-width: 899px) {
    .brasa:nth-child(n + 11), .poeira:nth-child(n + 8), .estrela:nth-child(n + 7), .risco:nth-child(n + 3) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-cenas *, .hero-cenas *::after { animation: none !important; transition-duration: 0.01ms !important; transition-delay: 0s !important; }
    .fx--frente { display: none; }
  }
</style>

<script>
  // Troca de cena + paralaxe. Cena da seção ativa vem do evento `hero:secao`
  // (o card central já dispara; ver script em Hero.astro).
  const raiz = document.querySelector<HTMLElement>('.hero-cenas');
  const hero = raiz?.closest<HTMLElement>('.hero');
  if (raiz && hero) {
    const cenas = Array.from(raiz.querySelectorAll<HTMLElement>('.cena'));
    const reduzir = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const carregar = (cena?: HTMLElement) => {
      cena?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        img.src = img.dataset.src ?? '';
        img.removeAttribute('data-src');
      });
    };
    const ativar = (id: string) => {
      const alvo = cenas.find((c) => c.dataset.secao === id) ?? cenas[0];
      carregar(alvo);
      cenas.forEach((c) => c.classList.toggle('is-ativa', c === alvo));
      // aquece as vizinhas quando o navegador estiver ocioso
      const i = cenas.indexOf(alvo);
      const aquecer = () => { carregar(cenas[(i + 1) % cenas.length]); carregar(cenas[(i - 1 + cenas.length) % cenas.length]); };
      'requestIdleCallback' in window ? requestIdleCallback(aquecer) : setTimeout(aquecer, 800);
    };
    document.addEventListener('hero:secao', (e) => ativar((e as CustomEvent<{ categoriaId?: string }>).detail?.categoriaId ?? ''));
    'requestIdleCallback' in window
      ? requestIdleCallback(() => carregar(cenas[1]))
      : setTimeout(() => carregar(cenas[1]), 1200);

    // pausa animações fora da tela
    let visivel = true;
    new IntersectionObserver(([entrada]) => {
      visivel = entrada.isIntersecting;
      raiz.classList.toggle('is-fora', !visivel);
    }).observe(hero);

    if (!reduzir) {
      const fino = matchMedia('(hover: hover) and (pointer: fine)').matches;
      let alvoX = 0, alvoY = 0, x = 0, y = 0, sy = 0, raf = 0;
      const passo = () => {
        x += (alvoX - x) * 0.09;
        y += (alvoY - y) * 0.09;
        raiz.style.setProperty('--px', x.toFixed(3));
        raiz.style.setProperty('--py', y.toFixed(3));
        raiz.style.setProperty('--sy', sy.toFixed(3));
        raf = Math.abs(alvoX - x) + Math.abs(alvoY - y) > 0.002 ? requestAnimationFrame(passo) : 0;
      };
      const iniciar = () => { if (!raf && visivel) raf = requestAnimationFrame(passo); };

      if (fino) {
        hero.addEventListener('pointermove', (e) => {
          const r = hero.getBoundingClientRect();
          alvoX = ((e.clientX - r.left) / r.width - 0.5) * 2;
          alvoY = ((e.clientY - r.top) / r.height - 0.5) * 2;
          iniciar();
        }, { passive: true });
        hero.addEventListener('pointerleave', () => { alvoX = 0; alvoY = 0; iniciar(); }, { passive: true });
      }
      addEventListener('scroll', () => {
        if (!visivel) return;
        const r = hero.getBoundingClientRect();
        sy = Math.min(1, Math.max(0, -r.top / r.height));
        iniciar();
      }, { passive: true });
    }
  }
</script>
