     (é o único interativo — pedido: "deixe o do centro ativo"); o do
     canto é exclusivo de desktop, onde cabem os dois. */
  .hero-media-texto {
    display: none;
  }

  .hero-media-carrossel {
    display: none;
  }

  .hero-media-central {
    display: flex;
    justify-content: center;
    z-index: 4;
    margin-inline: var(--hero-gutter);
    margin-block-end: clamp(14px, 4vw, 32px);
