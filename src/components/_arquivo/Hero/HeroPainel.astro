  /* Texto era branco (fundo --acento saturado); no concreto claro vira
     tinta escura — mesma lógica de opacidades, tom invertido. */
  .hero-texto { display: flex; flex-direction: column; gap: var(--sp-3); color: #17140f; }
  .hero-kicker { color: rgba(23, 20, 15, 0.68); }
  .hero-titulo {
