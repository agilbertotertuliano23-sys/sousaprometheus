    .hero-wordmark {
      display: block;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.01em;
      line-height: 0.95;
      font-size: clamp(3rem, 1.8rem + 4.5vw, 4.8rem);
