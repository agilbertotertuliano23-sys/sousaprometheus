---
/**
 * GaleriaMidia — E5-02 (RF-12). Imagens + vídeos 9:16 numa faixa `scroll-snap`
 * horizontal com dots. Sem JS: faixa/pilha rolável de `<img>` + `<video
 * controls>`; os dots são âncoras `#g-<sku>-<i>` que rolam para cada item.
 *
 * `prefers-reduced-motion: reduce` → `scroll-snap-type: none`, sem transição.
 * O `<script>` local (opcional, com guarda de reduced-motion) só acende o dot
 * ativo via IntersectionObserver — sem ele os dots continuam navegando.
 *
 * Nenhuma mídia `eager` (o detalhe nunca é o 1º paint — RNF-13). Vídeos
 * `preload="none"` + `data-vertical` para o `ligarVideoVertical` (E6-02) religar.
 */
import type { ItemMidia } from '../../data/tipos';
import { urlAsset } from '../../lib/catalogo/carregar';

interface Props {
  itens: ItemMidia[];
  slug: string;
  sku: string;
}

const { itens, slug, sku } = Astro.props;
---
<figure class="galeria" role="group" aria-label="Galeria do produto">
  <ol class="galeria-faixa">
    {itens.map((m, i) => (
      <li id={`g-${sku}-${i}`} class="galeria-item">
        {m.tipo === 'video' ? (
          <video
            class="galeria-media"
            data-vertical
            controls
            muted
            playsinline
            loop
            preload="none"
            src={urlAsset(slug, m.src)}
            poster={m.poster ? urlAsset(slug, m.poster) : undefined}
            aria-label={m.alt}
          ></video>
        ) : (
          <img
            class="galeria-media"
            src={urlAsset(slug, m.src)}
            alt={m.alt}
            width="720"
            height="1280"
            loading="lazy"
            decoding="async"
          />
        )}
      </li>
    ))}
  </ol>

  {itens.length > 1 && (
    <nav class="galeria-dots" aria-label="Ir para item">
      {itens.map((_, i) => (
        <a
          class="dot"
          href={`#g-${sku}-${i}`}
          aria-label={`Item ${i + 1}`}
          aria-current={i === 0 ? 'true' : undefined}></a>
      ))}
    </nav>
  )}
</figure>

<style>
  .galeria { margin: 0; }
  .galeria-faixa {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--sp-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }
  .galeria-item {
    flex: 0 0 100%;
    scroll-snap-align: center;
    aspect-ratio: 9 / 16;
  }
  .galeria-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--raio-sm);
    background: var(--superficie-alta);
  }
  .galeria-dots {
    display: flex;
    justify-content: center;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
  }
  .dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--toque-min);
    min-height: var(--toque-min);
  }
  .dot::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--linha);
  }
  .dot[aria-current='true']::after { background: var(--acento); }

  @media (prefers-reduced-motion: reduce) {
    .galeria-faixa { scroll-snap-type: none; scroll-behavior: auto; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .galeria-faixa { scroll-behavior: smooth; }
  }
</style>

<script>
  // Acende o dot do item central. Guarda de reduced-motion (RNF-08). Se falhar,
  // os dots seguem navegando por âncora.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const fig of document.querySelectorAll<HTMLElement>('.galeria')) {
      const itens = fig.querySelectorAll<HTMLElement>('.galeria-item');
      const dots = fig.querySelectorAll<HTMLElement>('.galeria-dots .dot');
      if (dots.length < 2) continue;
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const i = [...itens].indexOf(e.target as HTMLElement);
            dots.forEach((d, j) =>
              j === i
                ? d.setAttribute('aria-current', 'true')
                : d.removeAttribute('aria-current'),
            );
          }
        },
        { root: fig.querySelector('.galeria-faixa'), threshold: 0.6 },
      );
      itens.forEach((it) => io.observe(it));
    }
  }
</script>
