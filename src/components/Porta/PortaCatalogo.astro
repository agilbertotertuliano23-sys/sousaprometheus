---
/**
 * PortaCatalogo — E6-04 (ADR-008 Fase 0, RF-15.5 revisto). A tela de entrada
 * apresenta o CATÁLOGO (proposta + organização), não um produto herói.
 *
 * kicker · título display · parágrafo de proposta · linha de organização
 * ("N produtos · M categorias") · mosaico curado de capas (derivado dos produtos
 * herói de cada categoria) · CTA no --acento → #tela-vitrine.
 *
 * Astro puro, sem `<script>`. Sem JS o CTA é âncora nativa; cada capa linka
 * `#cat-<id>` (ou `#produto-<sku>`). Só as 2 primeiras capas são `eager` — a
 * única mídia eager da página (RNF-13). Todo campo de `nicho.entrada` opcional.
 */
import type { Nicho } from '../../data/tipos';
import {
  resolverCategorias,
  produtosPorCategoria,
  galeriaDe,
} from '../../lib/catalogo/resolver';
import { urlAsset } from '../../lib/catalogo/carregar';

interface Props {
  nicho: Nicho;
}

const { nicho } = Astro.props;

const cats = resolverCategorias(nicho, 'a');
const porCat = produtosPorCategoria(nicho, 'a');
const K = nicho.produtos.length;
const C = cats.length;

const kicker =
  nicho.entrada?.kicker ?? `VITRINE · ${nicho.nome.toUpperCase()}`;
const proposta = nicho.entrada?.proposta ?? nicho.subtitulo;
const chamada = nicho.entrada?.chamada ?? 'Entrar no catálogo';

// Linha de organização — Fase 0 não tem grupos/estilos (D-14).
const cat0Sintetica = cats[0]?.id.startsWith('_') ?? true;
const linhaOrg =
  C > 1 || !cat0Sintetica
    ? `${K} produto${K === 1 ? '' : 's'} · ${C} categoria${C === 1 ? '' : 's'}`
    : `${K} produto${K === 1 ? '' : 's'}`;

// Mosaico: capa do herói de cada categoria; completa por prioridade até >= 3.
type Capa = { src: string; alt: string; href: string; ir: 'vitrine' | 'detalhe' };
const usados = new Set<string>();
const mosaico: Capa[] = [];
for (const c of cats) {
  const h = porCat.get(c.id)?.[0];
  if (h && !usados.has(h.sku)) {
    const capa = galeriaDe(h)[0];
    if (capa?.tipo === 'imagem') {
      mosaico.push({ src: capa.src, alt: capa.alt, href: `#cat-${c.id}`, ir: 'vitrine' });
      usados.add(h.sku);
    }
  }
  if (mosaico.length >= 5) break;
}
if (mosaico.length < 3) {
  const resto = [...nicho.produtos]
    .filter((p) => !usados.has(p.sku))
    .sort((a, b) => (b.prioridade ?? 50) - (a.prioridade ?? 50));
  for (const p of resto) {
    const capa = galeriaDe(p)[0];
    if (capa?.tipo === 'imagem') {
      mosaico.push({ src: capa.src, alt: capa.alt, href: `#produto-${p.sku}`, ir: 'detalhe' });
      usados.add(p.sku);
      if (mosaico.length >= 4) break;
    }
  }
}
---
<div class="porta">
  <p class="rotulo" data-slot="kicker">{kicker}</p>
  <h1 class="porta-titulo" data-slot="titulo">{nicho.titulo}</h1>
  <p class="porta-proposta" data-slot="subtitulo">{proposta}</p>
  {linhaOrg && <p class="porta-org rotulo" data-slot="entrada-org">{linhaOrg}</p>}

  {mosaico.length > 0 && (
    <ul class="porta-mosaico" aria-label="Amostra do catálogo">
      {mosaico.map((capa, i) => (
        <li>
          <a
            class="porta-capa"
            href={capa.href}
            data-ir={capa.ir}
            data-cat={capa.ir === 'vitrine' ? capa.href.replace('#cat-', '') : undefined}>
            <img
              src={urlAsset(nicho.slug, capa.src)}
              alt={capa.alt}
              width="720"
              height="1280"
              loading={i < 2 ? 'eager' : 'lazy'}
              fetchpriority={i < 2 ? 'high' : undefined}
              decoding="async"
            />
          </a>
        </li>
      ))}
    </ul>
  )}

  <a
    class="porta-cta"
    href="#tela-vitrine"
    data-ir="vitrine"
    data-slot="entrada-cta">{chamada} ›</a>

  <div data-slot="entrada-oferta" hidden></div>
</div>
<style>
  .porta { display: flex; flex-direction: column; gap: var(--sp-3); }
  .porta-titulo { font-size: var(--fs-4); line-height: 1.05; }
  .porta-proposta { color: var(--texto-fraco); max-width: 34ch; }
  .porta-org { color: var(--texto-fraco); }

  .porta-mosaico {
    list-style: none;
    margin: var(--sp-2) calc(-1 * var(--sp-4));
    padding: 0 var(--sp-4);
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-auto-rows: 1fr;
    gap: var(--sp-2);
  }
  .porta-mosaico li:first-child { grid-row: span 2; }
  .porta-capa { display: block; }
  .porta-capa img {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: var(--card-raio, var(--raio-sm));
    background: var(--superficie-alta);
  }

  .porta-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--toque-min);
    border-radius: var(--raio-sm);
    background: var(--acento);
    color: #fff; /* RNF-07: AA sobre #1E6FFF; acento claro exige --acento-texto */
    font-family: var(--f-display);
    font-weight: 600;
  }
</style>
