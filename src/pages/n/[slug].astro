---
import Base from '../../layouts/Base.astro';
import SecaoUnica from '../../components/SecaoUnica.astro';
import { StickyBanner } from '../../components/base-ui/sticky-banner';
import { SLUGS, resolverNicho } from '../../data/nichos';

// Rota estática por nicho (`/n/<slug>`) — E6-03. Usa a MESMA seção única de `/`,
// buildada com o nicho da rota. O markup mora em SecaoUnica.astro (fonte única).
//
// TODO(E4-01): OG/canonical por nicho (src/lib/seo/og.ts).
// TODO(E4-02): incluir estas rotas em src/pages/sitemap.xml.ts.
export function getStaticPaths() {
  return SLUGS.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const nicho = resolverNicho(slug);
---
<Base titulo={nicho.og?.titulo ?? nicho.titulo} descricao={nicho.og?.descricao ?? nicho.subtitulo}>
  <StickyBanner client:idle delayMs={3000}>
    <p class="mx-0 max-w-[90%]">
      Frete grátis em compras acima de R$ 150 — só esta semana.{' '}
      <a href="#tela-vitrine" class="underline underline-offset-2 transition hover:opacity-80">
        Ver catálogo
      </a>
    </p>
  </StickyBanner>
  <main class="pagina">
    <SecaoUnica nicho={nicho} />
  </main>
</Base>
