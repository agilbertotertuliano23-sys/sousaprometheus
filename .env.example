# PROMETEUS — variáveis de build (todas opcionais; o projeto roda sem nenhuma).
# Copie para .env e ajuste. Nada aqui é segredo: é build estático.

# Nicho servido quando a URL não traz ?n= (fallback do fallback).
PUBLIC_NICHO_PADRAO=exemplo

# Base pública do site (usada em canonical/OG). Sem barra final.
PUBLIC_SITE_URL=https://exemplo.com
